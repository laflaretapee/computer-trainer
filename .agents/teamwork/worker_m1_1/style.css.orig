/* =====================================================
   КОМПЬЮТЕРНЫЙ ТРЕНАЖЁР — 7 КЛАСС
   style.css
   ===================================================== */

/* ─── Переменные ─────────────────────────────────── */
:root {
  --color-primary:   #2563eb;
  --color-primary-h: #1d4ed8;
  --color-accent:    #16a34a;
  --color-accent-h:  #15803d;
  --color-error:     #dc2626;
  --color-error-h:   #b91c1c;
  --color-warn:      #f97316;    /* key-next / orange */

  --color-bg:        #f0f4ff;
  --color-surface:   #ffffff;
  --color-border:    #d1d5db;
  --color-text:      #1e293b;
  --color-muted:     #64748b;

  --radius-sm:  8px;
  --radius-md:  12px;
  --radius-lg:  20px;

  --shadow-sm:  0 1px 3px rgba(0,0,0,.12);
  --shadow-md:  0 4px 12px rgba(37,99,235,.18);
  --shadow-lg:  0 8px 24px rgba(37,99,235,.22);

  --transition: .18s ease;
}

/* ─── Reset & Base ───────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  font-size: 16px;
  background: var(--color-bg);
  color: var(--color-text);
  min-width: 1024px;
}

/* ─── Экраны ─────────────────────────────────────── */
.screen {
  display: none;
  min-height: 100vh;
  animation: fadeIn .2s ease both;
}

.screen.active {
  display: flex;
  flex-direction: column;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── Шапка экрана ───────────────────────────────── */
.screen-header {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 32px;
  background: var(--color-surface);
  border-bottom: 2px solid var(--color-primary);
  box-shadow: var(--shadow-sm);
}

.screen-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--color-primary);
}

/* ─── Тело экрана ────────────────────────────────── */
.screen-body {
  flex: 1;
  padding: 32px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  overflow-y: auto;
}

/* ─── Центрирующий контейнер (login) ─────────────── */
.screen-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
}

/* ─── Логотип ────────────────────────────────────── */
.app-logo {
  text-align: center;
  margin-bottom: 48px;
}

.logo-icon {
  font-size: 4rem;
  display: block;
  margin-bottom: 12px;
}

.app-title {
  font-size: 2rem;
  font-weight: 800;
  color: var(--color-primary);
  letter-spacing: -.5px;
}

.app-subtitle {
  font-size: 1.1rem;
  color: var(--color-muted);
  margin-top: 4px;
}

/* ─── Кнопки выбора роли ─────────────────────────── */
.role-buttons {
  display: flex;
  gap: 24px;
}

.btn-role {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  min-width: 180px;
  padding: 28px 36px !important;
  font-size: 1.1rem;
}

.btn-role .btn-icon {
  font-size: 2.4rem;
}

/* ─── Кнопки (базовые) ───────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 28px;
  font-size: 1rem;
  font-weight: 600;
  font-family: inherit;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background var(--transition), box-shadow var(--transition),
              transform var(--transition);
  user-select: none;
  text-align: center;
}

.btn:active {
  transform: scale(.97);
}

/* Primary */
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-sm);
}
.btn-primary:hover {
  background: var(--color-primary-h);
  box-shadow: var(--shadow-md);
}

/* Secondary */
.btn-secondary {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
}
.btn-secondary:hover {
  background: #eff6ff;
  box-shadow: var(--shadow-md);
}

/* Accent */
.btn-accent {
  background: var(--color-accent);
  color: #fff;
}
.btn-accent:hover {
  background: var(--color-accent-h);
  box-shadow: 0 4px 12px rgba(22,163,74,.3);
}

/* Back */
.btn-back {
  background: transparent;
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
  padding: 10px 18px;
  font-size: .9rem;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.btn-back:hover {
  background: var(--color-primary);
  color: #fff;
}

/* Full-width */
.btn-block {
  width: 100%;
}

/* Disabled */
.btn:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none;
}

/* ─── Класс-кнопки (7А, 7Б …) ───────────────────── */
.class-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
  margin-top: 24px;
}

.btn-class {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 3px solid var(--color-primary);
  font-size: 1.5rem;
  font-weight: 800;
  min-width: 140px;
  min-height: 100px;
  border-radius: var(--radius-lg);
  transition: background var(--transition), box-shadow var(--transition),
              transform var(--transition);
}
.btn-class:hover {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}

/* ─── Информация об ученике (menu header) ─────────── */
.student-info {
  display: flex;
  flex-direction: column;
  margin-left: auto;
  text-align: right;
}
.student-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-text);
}
.student-class {
  font-size: .85rem;
  color: var(--color-muted);
}

/* ─── Поиск ──────────────────────────────────────── */
.search-box {
  max-width: 480px;
}

.search-input {
  width: 100%;
  font-size: 1rem;
}

/* ─── Список учеников (grid 2 колонки) ───────────── */
.student-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.btn-student {
  background: var(--color-surface);
  color: var(--color-text);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 18px 20px;
  font-size: 1rem;
  font-weight: 600;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 4px;
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition), box-shadow var(--transition),
              transform var(--transition);
}
.btn-student:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.btn-student .student-num {
  font-size: .8rem;
  color: var(--color-muted);
  font-weight: 400;
}

/* ─── Модули (меню ученика) ──────────────────────── */
.module-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  max-width: 760px;
}

.btn-module {
  background: var(--color-surface);
  color: var(--color-text);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  font-size: 1rem;
  text-align: left;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition), box-shadow var(--transition),
              transform var(--transition);
}
.btn-module:hover {
  border-color: var(--color-primary);
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}
.module-icon {
  font-size: 2rem;
}
.module-name {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-primary);
}
.module-desc {
  font-size: .85rem;
  color: var(--color-muted);
  font-weight: 400;
}

/* ─── Контейнер модулей ──────────────────────────── */
.module-container {
  width: 100%;
  min-height: 400px;
}

/* ─── Поля ввода ─────────────────────────────────── */
.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}
.form-group label {
  font-size: .9rem;
  font-weight: 600;
  color: var(--color-text);
}
.form-input {
  padding: 12px 16px;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 1rem;
  font-family: inherit;
  outline: none;
  transition: border-color var(--transition), box-shadow var(--transition);
  background: var(--color-surface);
  color: var(--color-text);
}
.form-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(37,99,235,.15);
}

/* ─── Карточка входа ─────────────────────────────── */
.login-card {
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 36px 40px;
  width: 100%;
  max-width: 400px;
  box-shadow: var(--shadow-md);
}
.login-card h2 {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 24px;
  text-align: center;
}

/* ─── Сообщения об ошибках ───────────────────────── */
.error-msg {
  color: var(--color-error);
  font-size: .9rem;
  margin-top: 10px;
  text-align: center;
}

/* ════════════════════════════════════════════════════
   КЛАССЫ ДЛЯ ТРЕНАЖЁРА ПЕЧАТИ (используются typing.js)
   ════════════════════════════════════════════════════ */

/* Символы текста */
.char-correct {
  color: var(--color-accent);
  background: rgba(22,163,74,.08);
}
.char-wrong {
  color: var(--color-error);
  text-decoration: underline wavy var(--color-error);
  background: rgba(220,38,38,.1);
}
.char-current {
  background: rgba(37,99,235,.2);
  border-bottom: 2.5px solid var(--color-primary);
  animation: blink .8s step-end infinite;
  border-radius: 2px;
}

@keyframes blink {
  0%, 100% { background: rgba(37,99,235,.22); }
  50%       { background: rgba(37,99,235,.06); }
}

/* ─── Схема клавиатуры ───────────────────────────── */
.keyboard {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: center;
  margin: 16px 0;
  user-select: none;
}
.keyboard-row {
  display: flex;
  gap: 5px;
}
.key {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 42px;
  height: 42px;
  padding: 0 8px;
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: 7px;
  font-size: .85rem;
  font-weight: 600;
  color: var(--color-text);
  box-shadow: 0 2px 0 var(--color-border);
  transition: background var(--transition), border-color var(--transition),
              transform .1s;
}
.key-space {
  min-width: 260px;
}

.key-active {
  background: var(--color-primary);
  border-color: var(--color-primary-h);
  color: #fff;
  box-shadow: 0 2px 0 var(--color-primary-h);
  transform: translateY(1px);
}
.key-next {
  background: #fff7ed;
  border-color: var(--color-warn);
  color: var(--color-warn);
  box-shadow: 0 2px 0 #c2410c;
  animation: keyPulse 1s ease-in-out infinite;
}

@keyframes keyPulse {
  0%, 100% { box-shadow: 0 2px 0 #c2410c, 0 0 0 0 rgba(249,115,22,.3); }
  50%       { box-shadow: 0 2px 0 #c2410c, 0 0 0 5px rgba(249,115,22,0); }
}

/* ─── Текст для набора ───────────────────────────── */
.typing-text {
  font-size: 1.5rem;
  font-family: 'Courier New', Courier, monospace;
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20px 24px;
  line-height: 2.2;
  letter-spacing: .06em;
  word-break: break-all;
  margin: 16px 0;
}
.typing-text span {
  border-radius: 2px;
  padding: 0 1px;
}

/* ─── Статистика (реальное время) ────────────────── */
.typing-stats {
  display: flex;
  gap: 32px;
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-muted);
}
.typing-stats .stat-value {
  color: var(--color-primary);
  font-size: 1.3rem;
}

/* ─── Прогресс-бар ───────────────────────────────── */
.stat-bar-wrap {
  width: 100%;
  background: #e2e8f0;
  border-radius: 999px;
  height: 10px;
  overflow: hidden;
}
.stat-bar {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
  transition: width .4s ease;
}
.stat-bar.stat-bar-warn { background: linear-gradient(90deg, var(--color-warn), var(--color-error)); }
.stat-bar.stat-bar-ok   { background: linear-gradient(90deg, var(--color-accent), #4ade80); }

/* ─── Карточка результата ────────────────────────── */
.result-card {
  background: var(--color-surface);
  border: 2px solid var(--color-accent);
  border-radius: var(--radius-lg);
  padding: 32px 36px;
  text-align: center;
  box-shadow: var(--shadow-md);
  animation: fadeIn .3s ease both;
}
.result-card h3 {
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--color-accent);
  margin-bottom: 20px;
}
.result-metrics {
  display: flex;
  justify-content: center;
  gap: 40px;
  margin-bottom: 24px;
}
.result-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.result-metric .metric-value {
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--color-primary);
}
.result-metric .metric-label {
  font-size: .85rem;
  color: var(--color-muted);
}
.result-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

/* ═══════════════════════════════════════════════════
   ПАНЕЛЬ УЧИТЕЛЯ (используется teacher.js)
   ═══════════════════════════════════════════════════ */

.teacher-panel {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 24px;
  min-height: 600px;
}
.teacher-sidebar {
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.teacher-content {
  background: var(--color-surface);
  border: 2px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24px;
}

.teacher-nav-btn {
  background: transparent;
  color: var(--color-text);
  border: none;
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-size: .95rem;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
  transition: background var(--transition), color var(--transition);
}
.teacher-nav-btn:hover,
.teacher-nav-btn.active {
  background: var(--color-primary);
  color: #fff;
}

/* ─── Таблица статистики ─────────────────────────── */
.stats-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .95rem;
}
.stats-table th {
  background: var(--color-primary);
  color: #fff;
  padding: 10px 14px;
  text-align: left;
  font-weight: 700;
}
.stats-table td {
  padding: 10px 14px;
  border-bottom: 1px solid var(--color-border);
}
.stats-table tr:hover td {
  background: #eff6ff;
}

/* ─── Уровни тренажёра ───────────────────────────── */
.level-selector {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}
.btn-level {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
  border-radius: var(--radius-sm);
  padding: 10px 20px;
  font-size: .95rem;
  font-weight: 700;
  transition: background var(--transition), color var(--transition);
}
.btn-level:hover,
.btn-level.active {
  background: var(--color-primary);
  color: #fff;
}

/* ─── Badge/метки ────────────────────────────────── */
.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: .78rem;
  font-weight: 700;
}
.badge-green  { background: #dcfce7; color: var(--color-accent); }
.badge-blue   { background: #dbeafe; color: var(--color-primary); }
.badge-red    { background: #fee2e2; color: var(--color-error); }
.badge-orange { background: #ffedd5; color: var(--color-warn); }

/* ─── Утилиты ─────────────────────────────────────── */
.mt-auto { margin-top: auto; }
.text-center { text-align: center; }
.text-muted  { color: var(--color-muted); }
.gap-16 { gap: 16px; }
.flex   { display: flex; }
.flex-col { flex-direction: column; }
.hidden { display: none !important; }


/* ── Дополнения для модулей: Материалы, Тесты, Панель учителя ── */

.stats-overview-banner {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
}
.stat-pill {
  background: #ffffff;
  padding: 10px 18px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  font-size: 15px;
  box-shadow: var(--shadow-sm);
}

.class-sub {
  display: block;
  font-size: 13px;
  opacity: 0.85;
  font-weight: normal;
  margin-top: 4px;
}
.class-title {
  font-size: 20px;
  font-weight: 700;
}

.student-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border: 1px solid var(--color-border);
  padding: 14px 18px;
  border-radius: var(--radius-md);
  cursor: pointer;
  font-size: 16px;
  font-weight: 600;
  transition: all var(--transition);
  text-align: left;
}
.student-card:hover {
  border-color: var(--color-primary);
  background: #f8faff;
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}
.student-badge {
  background: #e0e7ff;
  color: var(--color-primary);
  font-size: 12px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
}

/* Материалы */
.materials-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}
.material-card {
  background: #ffffff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm);
}
.mat-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
  font-size: 13px;
}
.mat-badge {
  background: #e0f2fe;
  color: #0369a1;
  padding: 3px 10px;
  border-radius: 12px;
  font-weight: 600;
}
.mat-slides-count {
  color: var(--color-muted);
}
.mat-title {
  font-size: 18px;
  margin-bottom: 10px;
  color: var(--color-text);
  line-height: 1.4;
}
.mat-desc {
  font-size: 14px;
  color: var(--color-muted);
  flex-grow: 1;
  margin-bottom: 20px;
}

/* Просмотрщик слайдов */
.slide-viewer {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 900px;
  margin: 0 auto;
}
.slide-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--color-border);
}
.slide-nav-btns {
  display: flex;
  gap: 10px;
}
.slide-img-box {
  background: #000;
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}
.slide-image {
  max-width: 100%;
  max-height: 520px;
  display: block;
  object-fit: contain;
}
.slide-notes {
  background: #f8fafc;
  padding: 16px;
  border-radius: var(--radius-md);
  font-size: 14px;
  line-height: 1.5;
  border-left: 4px solid var(--color-primary);
}

/* Тесты */
.tests-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}
.test-card {
  background: #ffffff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
}
.test-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}
.test-icon {
  font-size: 28px;
}
.test-qcount {
  font-size: 13px;
  background: #f1f5f9;
  padding: 4px 10px;
  border-radius: 12px;
  color: var(--color-muted);
  font-weight: 600;
}
.test-title {
  font-size: 18px;
  margin-bottom: 20px;
  line-height: 1.4;
  flex-grow: 1;
}

.test-runner {
  max-width: 720px;
  margin: 0 auto;
  background: #ffffff;
  padding: 32px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-md);
}
.test-progress-bar {
  height: 8px;
  background: #e2e8f0;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 20px;
}
.test-progress-fill {
  height: 100%;
  background: var(--color-primary);
  transition: width 0.3s ease;
}
.test-meta-info {
  display: flex;
  justify-content: space-between;
  font-size: 14px;
  color: var(--color-muted);
  margin-bottom: 18px;
}
.test-q-text {
  font-size: 20px;
  margin-bottom: 24px;
  line-height: 1.4;
}
.answers-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.answer-btn {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 20px;
  border: 2px solid #e2e8f0;
  border-radius: var(--radius-md);
  background: #ffffff;
  cursor: pointer;
  text-align: left;
  font-size: 16px;
  transition: all var(--transition);
}
.answer-btn:hover:not(:disabled) {
  border-color: var(--color-primary);
  background: #f8faff;
}
.ans-letter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: #f1f5f9;
  border-radius: 50%;
  font-weight: 700;
  color: var(--color-text);
  flex-shrink: 0;
}
.answer-btn.answer-correct {
  border-color: var(--color-accent);
  background: #f0fdf4;
}
.answer-btn.answer-correct .ans-letter {
  background: var(--color-accent);
  color: #fff;
}
.answer-btn.answer-wrong {
  border-color: var(--color-error);
  background: #fef2f2;
}
.answer-btn.answer-wrong .ans-letter {
  background: var(--color-error);
  color: #fff;
}

.grade-5 { color: #16a34a; font-weight: 800; font-size: 28px; }
.grade-4 { color: #2563eb; font-weight: 800; font-size: 28px; }
.grade-3 { color: #f59e0b; font-weight: 800; font-size: 28px; }
.grade-2 { color: #dc2626; font-weight: 800; font-size: 28px; }

/* Панель учителя */
.teacher-dashboard {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.teacher-stats-bar {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.t-stat-card {
  background: #ffffff;
  border: 1px solid var(--color-border);
  padding: 20px;
  border-radius: var(--radius-md);
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.t-stat-card.highlight {
  border-color: var(--color-primary);
  background: #f0f7ff;
}
.t-stat-num {
  display: block;
  font-size: 32px;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 6px;
}
.t-stat-label {
  font-size: 14px;
  color: var(--color-muted);
}
.teacher-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  padding: 16px 20px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
}
.teacher-filter-group {
  display: flex;
  align-items: center;
  gap: 12px;
}
.form-select {
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  font-size: 15px;
}
.teacher-actions {
  display: flex;
  gap: 10px;
}
.teacher-table {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--color-border);
}
.teacher-table th, .teacher-table td {
  padding: 14px 18px;
  text-align: left;
  border-bottom: 1px solid #f1f5f9;
  font-size: 14px;
}
.teacher-table th {
  background: #f8fafc;
  color: var(--color-muted);
  font-weight: 700;
}
.teacher-table tr.row-active {
  background: #f0fdf4;
}
.btn-sm {
  padding: 6px 12px;
  font-size: 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: #fff;
  cursor: pointer;
}
.btn-clear-student:hover {
  background: #fef2f2;
  color: var(--color-error);
  border-color: var(--color-error);
}

/* Результаты ученика */
.results-wrapper {
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.results-block {
  background: #ffffff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 24px;
  box-shadow: var(--shadow-sm);
}
.results-block h3 {
  margin-bottom: 16px;
  font-size: 18px;
}
.stat-summary-boxes {
  display: flex;
  gap: 16px;
  margin-bottom: 18px;
}
.sum-box {
  background: #f8fafc;
  border: 1px solid var(--color-border);
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  font-size: 14px;
}
.simple-table {
  width: 100%;
  border-collapse: collapse;
}
.simple-table th, .simple-table td {
  padding: 10px 14px;
  text-align: left;
  border-bottom: 1px solid #f1f5f9;
  font-size: 14px;
}
.simple-table th {
  background: #f8fafc;
  font-weight: 600;
  color: var(--color-muted);
}

/* Модалка */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.65);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 20px;
}
.modal-box {
  background: #ffffff;
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 960px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--color-border);
  padding-bottom: 12px;
}
.modal-close {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: var(--color-muted);
}
.modal-close:hover {
  color: var(--color-text);
}
